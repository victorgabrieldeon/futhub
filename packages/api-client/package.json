    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@dreamfut/config": "workspace:*",
    "@types/node": "22.13.4",
    "orval": "8.24.0",
    "tsx": "4.19.3",
    "typescript": "6.0.3"
  }
}
