{
  "name": "@futhub/bot-templates",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fonts/*": "./fonts/*"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "tsx --test src/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@futhub/config": "workspace:*",
    "@types/node": "22.13.4",
    "tsx": "4.19.3",
    "typescript": "6.0.3"
  }
}
