{
  "name": "@futhub/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "ttsc -p tsconfig.build.json",
    "dev": "pnpm openapi:generate && ttsc -p tsconfig.build.json && concurrently -k \"ttsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --env-file=../../.env --watch dist/server.js\"",
    "openapi:generate": "nestia swagger && biome format --write openapi.json",
    "generate:module": "node scripts/generate-module.mjs",
    "generate:usecase": "node scripts/generate-usecase.mjs",
    "files:backfill": "ttsc -p tsconfig.build.json && node --env-file=../../.env dist/scripts/backfill-file-references.js",
    "start": "node --env-file=../../.env dist/server.js",
    "test": "vitest run",
    "test:generators": "node --test scripts/*.test.mjs",
    "typecheck": "ttsc --noEmit"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "10.1.2",
    "@futhub/database": "workspace:*",
    "@nestia/core": "12.1.0",
    "@nestia/fetcher": "12.1.0",
    "@nestia/sdk": "12.1.0",
    "@nestjs/common": "11",
    "@nestjs/core": "11",
    "@nestjs/platform-fastify": "11",
    "@nestjs/swagger": "11",
    "@scalar/client-side-rendering": "^0.3.10",
    "exceljs": "^4.4.0",
    "fastify": "5.2.1",
    "minio": "^8.0.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typia": "13.3.0"
  },
  "devDependencies": {
    "@futhub/config": "workspace:*",
    "@nestjs/testing": "11",
    "@ttsc/unplugin": "0.27.0",
    "@types/node": "22.13.4",
    "concurrently": "10.0.5",
    "nestia": "12.1.0",
    "testcontainers": "11",
    "ttsc": "0.27.0",
    "vitest": "3.0.5"
  }
}
