{
  "name": "@futhub/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "pnpm openapi:generate && concurrently -k \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --env-file=../../.env --watch-path=dist --watch-path=../../packages/database --watch-path=../../packages/bot-templates dist/server.js\"",
    "openapi:generate": "tsc -p tsconfig.build.json && node dist/scripts/generate-openapi.js && biome format --write openapi.json",
    "generate:module": "node scripts/generate-module.mjs",
    "generate:usecase": "node scripts/generate-usecase.mjs",
    "files:backfill": "tsc -p tsconfig.build.json && node --env-file=../../.env dist/scripts/backfill-file-references.js",
    "start": "node --env-file=../../.env dist/server.js",
    "test": "vitest run",
    "test:generators": "node --test scripts/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "3.0.58",
    "@ai-sdk/openai": "3.0.41",
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "10.1.2",
    "@futhub/bot-templates": "workspace:*",
    "@futhub/database": "workspace:*",
    "@napi-rs/canvas": "0.1.95",
    "@nestjs/common": "12",
    "@nestjs/core": "12",
    "@nestjs/platform-fastify": "12",
    "@nestjs/swagger": "12",
    "@scalar/client-side-rendering": "^0.3.10",
    "ai": "6.0.116",
    "exceljs": "^4.4.0",
    "fastify": "5.2.1",
    "minio": "^8.0.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@futhub/config": "workspace:*",
    "@nestjs/testing": "12",
    "@types/node": "22.13.4",
    "concurrently": "10.0.5",
    "testcontainers": "11",
    "typescript": "6.0.3",
    "vitest": "3.0.5"
  }
}
