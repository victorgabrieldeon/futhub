{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "organizeImports": {
    "enabled": true
  },
  "files": {
    "ignore": [
      "**/.turbo/**",
      "**/dist/**",
      "**/coverage/**",
      "**/drizzle/**",
      "packages/api-client/src/generated.ts",
      "apps/admin/src/api/generated.ts",
      ".agents/**",
      ".openclaude/skills/**",
      "references/**",
      ".openclaude/worktrees/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "javascript": {
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    },
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  }
}
